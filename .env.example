# ============ TELEGRAM ============
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# ============ LLM ============
# Провайдер: deepseek | openai | ollama | groq | mistral | gemini | openrouter
# Один класс клиента (OpenAI-совместимый) + пресеты: меняешь одну строку — и всё работает.
LLM_PROVIDER=deepseek
# Ключ API (для ollama не нужен)
LLM_API_KEY=
# Необязательно: перекрывают пресет провайдера
#LLM_BASE_URL=
#LLM_MODEL=
LLM_TEMPERATURE=0.3

# ============ STT (голос -> текст) ============
# faster-whisper (локально) | openai (API whisper-1)
STT_PROVIDER=faster-whisper
STT_MODEL=small
#STT_API_KEY=

# ============ TTS (текст -> голос) ============
# edge-tts (бесплатно) | openai (API)
TTS_PROVIDER=edge-tts
TTS_VOICE=en-US-JennyNeural

# ============ ПРОЧЕЕ ============
DATABASE_PATH=data/english_bot.db
MAX_CONTEXT_MESSAGES=6
MAX_VOICE_DURATION_SEC=60
